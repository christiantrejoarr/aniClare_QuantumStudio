# Copia este archivo a .env. Valores solo para desarrollo local.
# En produccion los secretos salen de HashiCorp Vault o AWS Secrets Manager.
# Nunca los guardes en codigo ni en PostgreSQL.

POSTGRES_USER=aniclare
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aniclare
POSTGRES_PORT=5432

VECTOR_USER=aniclare
VECTOR_PASSWORD=change-me-local-only
VECTOR_DB=aniclare_vectors
VECTOR_PORT=5433

REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379

MINIO_ROOT_USER=aniclare
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

VAULT_DEV_ROOT_TOKEN_ID=change-me-local-only
VAULT_PORT=8200

# Clave del panel /admin. Solo desarrollo local.
ADMIN_ACCESS_TOKEN=change-me-local-only
